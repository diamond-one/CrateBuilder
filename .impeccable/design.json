  "narrative": {
    "northStar": "Grunge sampler workbench",
    "overview": "The selected gallery Grunge direction gives a working sampler surface charcoal material, warm lettering and worn red inspection states. CrateBuilder is a Windows CustomTkinter desktop application. Its visual vocabulary supports making and hearing a kit repeatedly, with the physical pad layout as the central instrument.\n\nOswald gives short display headings their identity; Segoe UI keeps filenames, choices and controls readable. Broken rules supply worn character around working regions, while text and waveforms sit on quiet solid surfaces. The implementation sources are `cratebuilder/desk_theme.py`, `cratebuilder/assets/grunge.json`, `cratebuilder/workspace.py` and the corresponding widget methods in `cratebuilder/ui.py`.",
    "keyCharacteristics": [
      "Warm charcoal layers with restrained broken-line detail.",
      "Worn red inspection states and pale warm action buttons.",
      "Labelled working controls around a physical four-column pad grid.",
      "Explicit distinction between hearing an alternative and keeping it."
    ],
    "rules": [
      {
        "name": "The State Has Words Rule",
        "body": "Preserve visible Select, Lock, LOCKED, PICK, warning marks and MIDI preview status; color alone must not carry these distinctions.",
        "section": "colors"
      },
      {
        "name": "The Working Type Rule",
        "body": "Reserve Oswald for short display headings. Keep pad labels, filenames, buttons and working text in Segoe UI.",
        "section": "typography"
      }
    ],
    "dos": [
      "**Do** use the gallery Grunge palette and bundled Oswald for short headings.",
      "**Do** keep working labels and filenames in Segoe UI on quiet solid surfaces.",
      "**Do** preserve physical pad mapping and separate inspection, selection and protection states.",
      "**Do** distinguish preview feedback from the explicit Use & lock action.",
      "**Do** keep main delivery actions and transfer-dialog final actions outside scrolling content."
    ],
    "donts": [
      "**Don't** add texture behind working text or replace tonal grouping with decorative shadows.",
      "**Don't** silently apply an alternative merely because the user heard it.",
      "**Don't** hide hardware destination or overwrite consequences inside connection options.",
      "**Don't** describe illustrative sidecar snippets as the native implementation or accessibility verification."
    ]
  }
}
